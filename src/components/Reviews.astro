---
import Icon from "./Icon.astro";
import { site } from "../lib/site";
---

{site.reviews.length > 0 && (
  <section class="section reviews" id="reviews" aria-labelledby="reviews-title">
    <div class="shell">
      <div class="section-heading reviews-heading">
        <div>
          <p class="eyebrow">Отзывы</p>
          <h2 id="reviews-title">Что говорят<br /><em>клиенты</em></h2>
        </div>
        {site.reputation && (
          <div class="review-score">
            <strong>{site.reputation.rating}</strong>
            <span>★</span>
            <small>{site.reputation.reviewCount} оценок</small>
          </div>
        )}
      </div>

      <div class="review-track" data-review-track tabindex="0" aria-label="Отзывы клиентов">
        {site.reviews.map((review) => (
          <article class="review-card">
            <span class="quote" aria-hidden="true">“</span>
            <p>{review.text}</p>
            <strong>{review.author}</strong>
          </article>
        ))}
      </div>

      {site.reputation?.reviewsUrl && (
        <a class="text-link all-reviews" href={site.reputation.reviewsUrl} target="_blank" rel="noopener">
          Все отзывы <Icon name="arrow" size={17} />
        </a>
      )}
    </div>
  </section>
)}
