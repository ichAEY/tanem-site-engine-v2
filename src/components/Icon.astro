  {name === "max" && <path d="M5 17V7l7 7 7-7v10M5 7h3l4 4 4-4h3" />}
  {name === "map" && <><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></>}
  {name === "custom" && <><circle cx="12" cy="12" r="9" /><path d="M8 12h8M12 8v8" /></>}
  {name === "arrow" && <path d="M5 12h14m-5-5 5 5-5 5" />}
  {name === "clock" && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
  {name === "close" && <path d="m6 6 12 12M18 6 6 18" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
