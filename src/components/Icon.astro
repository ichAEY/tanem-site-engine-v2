  {name === "whatsapp" && <><path d="M20 11.7a8 8 0 0 1-11.8 7L4 20l1.3-4.1A8 8 0 1 1 20 11.7Z" /><path d="M9 8.2c.2-.4.4-.4.7-.4h.5l.8 2c.1.3 0 .5-.2.7l-.6.7c.8 1.6 2 2.7 3.7 3.4l.7-.8c.2-.2.5-.3.7-.2l1.9.9c.3.1.4.3.3.6-.2 1.2-1.2 2-2.4 2-1.6 0-4.2-1.2-6.1-3.2-1.5-1.5-2.6-3.6-2.5-5 0-.7.2-1.1.5-1.4Z" /></>}
  {name === "telegram" && <path d="m3 11 17-7-3 16-5-4-3 3 .5-4.5L17 7 8.5 13 3 11Z" />}
