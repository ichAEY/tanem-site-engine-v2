{
  "$id": "https://raw.githubusercontent.com/ichAEY/tanem-site-engine-v2/v0.1.0/site.schema.json",
  "title": "TANEM master site data v2",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "number",
      "const": 2
    },
    "layout": {
      "type": "string",
      "const": "master"
    },
    "specialty": {
      "type": "string",
      "enum": [
        "nails",
        "hair",
        "brows",
        "lashes",
        "cosmetology",
        "universal"
      ]
    },
    "brand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "monogram": {
          "type": "string",
          "minLength": 1
        },
        "logo": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string"
            }
          },
          "required": [
            "src",
            "alt"
          ]
        },
        "favicon": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string"
            }
          },
          "required": [
            "src",
            "alt"
          ]
        }
      },
      "required": [
        "name",
        "monogram"
      ]
    },
    "master": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "profession": {
          "type": "string",
          "minLength": 1
        },
        "locationLabel": {
          "type": "string",
          "minLength": 1
        },
        "heroTitle": {
          "type": "string",
          "minLength": 1
        },
        "heroAccent": {
          "type": "string",
          "minLength": 1
        },
        "heroCopy": {
          "type": "string",
          "minLength": 1
        },
        "experience": {
          "type": "string",
          "minLength": 1
        },
        "experienceLabel": {
          "default": "лет опыта",
          "type": "string",
          "minLength": 1
        },
        "aboutTitle": {
          "type": "string",
          "minLength": 1
        },
        "aboutLead": {
          "type": "string",
          "minLength": 1
        },
        "aboutParagraphs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "skills": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "name",
        "profession",
        "locationLabel",
        "heroTitle",
        "heroAccent",
        "heroCopy",
        "experience",
        "aboutTitle",
        "aboutLead",
        "aboutParagraphs"
      ]
    },
    "location": {
      "type": "object",
      "properties": {
        "city": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "mapCardAddress": {
          "type": "string",
          "minLength": 1
        },
        "scheduleLabel": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "default": "Europe/Moscow",
          "type": "string",
          "minLength": 1
        },
        "weeklyHours": {
          "default": [],
          "maxItems": 7,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "day": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "open": {
                "type": "string",
                "pattern": "^\\d{2}:\\d{2}$"
              },
              "close": {
                "type": "string",
                "pattern": "^\\d{2}:\\d{2}$"
              },
              "closed": {
                "type": "boolean"
              }
            },
            "required": [
              "day"
            ]
          }
        },
        "mapEmbedUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "city",
        "address",
        "mapCardAddress",
        "scheduleLabel"
      ]
    },
    "contacts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "phone",
              "booking",
              "whatsapp",
              "telegram",
              "vk",
              "max",
              "map",
              "custom"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "primary": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "label",
          "url"
        ]
      }
    },
    "bookingUrl": {
      "type": "string",
      "format": "uri"
    },
    "reputation": {
      "type": "object",
      "properties": {
        "rating": {
          "type": "string",
          "minLength": 1
        },
        "reviewCount": {
          "type": "string",
          "minLength": 1
        },
        "reviewsUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "rating",
        "reviewCount"
      ]
    },
    "hero": {
      "type": "object",
      "properties": {
        "portrait": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string"
            }
          },
          "required": [
            "src",
            "alt"
          ]
        },
        "aboutPhoto": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string"
            }
          },
          "required": [
            "src",
            "alt"
          ]
        },
        "mobileVisual": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string"
            }
          },
          "required": [
            "src",
            "alt"
          ]
        },
        "thirdStat": {
          "default": "services",
          "type": "string",
          "enum": [
            "reviews",
            "services"
          ]
        }
      },
      "required": [
        "portrait"
      ]
    },
    "portfolio": {
      "type": "object",
      "properties": {
        "title": {
          "default": "Работы",
          "type": "string",
          "minLength": 1
        },
        "lead": {
          "type": "string"
        },
        "gallery": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "type": "string"
              }
            },
            "required": [
              "src",
              "alt"
            ]
          }
        },
        "beforeAfter": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "before": {
                "type": "object",
                "properties": {
                  "src": {
                    "type": "string",
                    "minLength": 1
                  },
                  "alt": {
                    "type": "string"
                  }
                },
                "required": [
                  "src",
                  "alt"
                ]
              },
              "after": {
                "type": "object",
                "properties": {
                  "src": {
                    "type": "string",
                    "minLength": 1
                  },
                  "alt": {
                    "type": "string"
                  }
                },
                "required": [
                  "src",
                  "alt"
                ]
              }
            },
            "required": [
              "before",
              "after"
            ]
          }
        }
      },
      "required": [
        "gallery"
      ]
    },
    "services": {
      "type": "object",
      "properties": {
        "intro": {
          "type": "string",
          "minLength": 1
        },
        "categories": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "services": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    },
                    "duration": {
                      "type": "string"
                    },
                    "price": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "fixed"
                            },
                            "value": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "type",
                            "value"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "from"
                            },
                            "value": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "type",
                            "value"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "text"
                            },
                            "value": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "type",
                            "value"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "const": "variants"
                            },
                            "variants": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "label": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "value": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "duration": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "label",
                                  "value"
                                ]
                              }
                            }
                          },
                          "required": [
                            "type",
                            "variants"
                          ]
                        }
                      ]
                    },
                    "bookingUrl": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "name",
                    "price"
                  ]
                }
              }
            },
            "required": [
              "id",
              "label",
              "services"
            ]
          }
        }
      },
      "required": [
        "intro",
        "categories"
      ]
    },
    "promotions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "highlight": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string"
          },
          "image": {
            "type": "object",
            "properties": {
              "src": {
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "type": "string"
              }
            },
            "required": [
              "src",
              "alt"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "title",
          "description"
        ]
      }
    },
    "reviews": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "author",
          "text"
        ]
      }
    },
    "amenities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "text"
        ]
      }
    },
    "seo": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "keywords": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "locale": {
          "default": "ru_RU",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "description"
      ]
    },
    "analytics": {
      "default": {},
      "type": "object",
      "properties": {
        "yandexMetrikaId": {
          "type": "string",
          "pattern": "^\\d+$"
        }
      }
    },
    "deployment": {
      "default": {},
      "type": "object",
      "properties": {
        "customDomain": {
          "type": "string",
          "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
        }
      }
    }
  },
  "required": [
    "version",
    "layout",
    "specialty",
    "brand",
    "master",
    "location",
    "contacts",
    "hero",
    "portfolio",
    "services",
    "seo"
  ]
}
